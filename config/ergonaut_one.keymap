#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3
#define HOT 4
#define GAM 5

&lt {
    quick-tap-ms = <150>;
    tapping-term-ms = <150>;
};

&mt {
    quick-tap-ms = <200>;
    tapping-term-ms = <200>;
};

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        game_layer_1_toggle {
            bindings = <&tog 5>;
            key-positions = <37 36 38>;
        };

        layer_4 {
            bindings = <&mo 4>;
            key-positions = <37 36>;
        };

        game_layer_2_toggle {
            bindings = <&tog 6>;
            key-positions = <40 39 41>;
        };

        rus_lang_layer_8 {
            bindings = <&mo 8>;
            key-positions = <37 38>;
        };

        bluetooth_layer {
            bindings = <&mo 3>;
            key-positions = <41 36>;
        };

        game_layer_3_toggle {
            bindings = <&tog 7>;
            key-positions = <35 34 33>;
        };
    };

    macros {
        lang_dollar: lang_dollar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp DOLLAR &kp LS(LEFT_ALT)>;
            label = "LANG_DLLR";
        };

        lang_hash: lang_hash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp HASH &kp LS(LEFT_ALT)>;
            label = "LANG_HASH";
        };

        lang_at: lang_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp AT_SIGN &kp LS(LEFT_ALT)>;
            label = "LANG_AT";
        };

        lang_excl: lang_excl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp EXCLAMATION &kp LS(LEFT_ALT)>;
            label = "LANG_EXCL";
        };

        lang_amps: lang_amps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp AMPERSAND &kp LS(LEFT_ALT)>;
            label = "LANG_AMPS";
        };

        lang_astr: lang_astr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp ASTERISK &kp LS(LEFT_ALT)>;
            label = "LANG_ASTR";
        };

        lang_lpar: lang_lpar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp LEFT_PARENTHESIS &kp LS(LEFT_ALT)>;
            label = "LANG_LPAR";
        };

        lang_rpas: lang_rpas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp RIGHT_PARENTHESIS &kp LS(LEFT_ALT)>;
            label = "LANG_RPAS";
        };

        lang_prcnt: lang_prcnt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp PERCENT &kp LS(LEFT_ALT)>;
            label = "LANG_PRCNT";
        };

        lang_caret: lang_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_ALT) &kp CARET &kp LS(LEFT_ALT)>;
            label = "LANG_CARET";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEF";
            bindings = <
&kp ESC    &kp BACKSLASH   &kp W           &kp E             &kp R        &kp T      &kp Y            &kp U        &kp I               &kp O            &trans                   &trans
&kp SLASH  &kp Q           &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &kp G      &kp H            &mt LCTRL J  &mt RIGHT_SHIFT K   &mt RIGHT_ALT L  &kp P                    &mt RIGHT_BRACKET LEFT_BRACKET
&kp Z      &mt LEFT_GUI A  &kp X           &kp C             &kp V        &kp B      &kp N            &kp M        &kp COMMA           &kp DOT          &mt RIGHT_GUI SEMICOLON  &kp SQT
                                           &lt 4 DEL         &lt 2 TAB    &lt 1 RET  &lt 1 BACKSPACE  &lt 2 SPACE  &lt 4 LS(LEFT_ALT)
            >;
        };

        lower_layer {
            display-name = "LWR";
            bindings = <
&mt LEFT_GUI F1    &kp F2    &kp F3  &kp F4    &kp F5    &kp F6     &kp F7     &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&mt LEFT_ALT PLUS  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &mt RIGHT_ALT MINUS
&mt LCTRL EQUAL    &kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &mt RCTRL DELETE
                                     &trans    &trans    &trans     &trans     &trans    &trans
            >;
        };

        raise_layer {
            display-name = "RSE";
            bindings = <
&mt LEFT_GUI KP_NUM  &kp KP_SLASH  &kp CLCK      &kp LC(PAGE_UP)  &kp INSERT  &kp LC(PAGE_DOWN)  &kp C_VOL_UP       &kp KP_N9  &kp KP_N8  &kp KP_N7  &kp PSCRN        &kp PAUSE_BREAK
&mt LEFT_ALT EQUAL   &kp PG_UP     &kp UP_ARROW  &kp DOWN         &kp RIGHT   &kp LA(N9)         &kp K_MUTE         &kp KP_N6  &kp KP_N5  &kp KP_N4  &kp KP_MULTIPLY  &kp SCROLLLOCK
&kp LCTRL            &kp LEFT      &kp PAGE_UP   &kp PAGE_DOWN    &kp HOME    &kp END            &kp C_VOLUME_DOWN  &kp KP_N3  &kp KP_N2  &kp KP_N1  &kp KP_N0        &mt RCTRL K_APP
                                                 &trans           &trans      &trans             &trans             &trans     &trans
            >;
        };

        bluetooth_layer {
            display-name = "BLU";
            bindings = <
&bootloader  &none         &none         &none         &out OUT_BLE  &out OUT_USB  &out OUT_USB  &out OUT_BLE  &none         &none         &none         &bootloader
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &sys_reset
                                         &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        hotcut_layer {
            display-name = "HOT";
            bindings = <
&kp LG(D)    &kp LS(LG(Z))  &kp LG(S)  &kp LS(LG(X))  &kp LG(R)  &kp GRAVE           &kp C_PREVIOUS  &trans  &kp LS(LG(PSCRN))  &trans      &trans                   &trans
&kp LA(TAB)  &kp LC(Z)      &kp LG(X)  &kp LG(C)      &kp LG(F)  &kp LC(LA(INSERT))  &kp C_PP        &trans  &kp LS(LG(S))      &kp LG(L)   &kp LG(LS(RIGHT_ARROW))  &trans
&trans       &kp LG(Z)      &kp LC(X)  &kp LC(C)      &kp LC(V)  &kp LC(LA(DELETE))  &kp C_NEXT      &trans  &lang_dollar       &lang_hash  &trans                   &trans
                                       &trans         &trans     &trans              &trans          &trans  &trans
            >;
        };

        game_layer_1 {
            display-name = "GAM1";
            bindings = <
&kp ESCAPE      &kp Q  &kp W  &kp E    &kp R      &kp T        &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL       &kp A  &kp S  &kp D    &kp F      &kp G        &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C    &kp V      &kp B        &trans  &trans  &trans  &trans  &trans  &trans
                              &kp TAB  &kp SPACE  &lt 1 ENTER  &trans  &trans  &trans
            >;
        };

        game_layer_2 {
            display-name = "GAM2";
            bindings = <
&kp ESCAPE      &kp Q           &kp UP_ARROW    &kp E            &kp R      &kp T  &trans     &trans  &trans  &trans  &trans  &trans
&kp LCTRL       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F      &kp G  &trans     &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp Z           &kp X           &kp C            &kp V      &kp B  &trans     &trans  &trans  &trans  &trans  &trans
                                                &kp TAB          &kp SPACE  &mo 1  &kp ENTER  &trans  &trans
            >;
        };

        game_layer_3 {
            display-name = "GAM3";
            bindings = <
&kp ESCAPE      &kp Q  &kp W  &kp E    &kp R      &kp T        &kp N5        &kp NUMBER_4  &kp NUMBER_3  &kp NUMBER_2  &kp NUMBER_1  &trans
&kp LCTRL       &kp A  &kp S  &kp D    &kp F      &kp G        &trans        &trans        &trans        &trans        &trans        &trans
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C    &kp V      &kp B        &trans        &trans        &trans        &trans        &trans        &trans
                              &kp TAB  &kp SPACE  &lt 1 ENTER  &kp LEFT_ALT  &trans        &trans
            >;
        };

        rus_lang {
            bindings = <
&kp F1             &kp F2      &kp F3    &kp F4      &kp F5        &kp F6       &kp F7       &kp F8      &kp F9      &kp F10     &kp F11     &kp F12
&mt LEFT_ALT PLUS  &lang_excl  &lang_at  &lang_hash  &lang_dollar  &lang_prcnt  &lang_caret  &lang_amps  &lang_astr  &lang_lpar  &lang_rpas  &mt RIGHT_ALT MINUS
&mt LCTRL EQUAL    &kp N1      &kp N2    &kp N3      &kp N4        &kp N5       &kp N6       &kp N7      &kp N8      &kp N9      &kp N0      &mt RCTRL DELETE
                                         &trans      &trans        &trans       &trans       &trans      &trans
            >;

            label = "RUS";
        };
    };
};
