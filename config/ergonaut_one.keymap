#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define BLU 3
#define HOT 4
#define CHG 5

&lt {
    quick-tap-ms = <150>;
    tapping-term-ms = <150>;
};

&mt {
    quick-tap-ms = <200>;
    tapping-term-ms = <220>;
};

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        bluetooth_layer_1 {
            bindings = <&mo BLU>;
            key-positions = <37 36 38>;
        };

        bluetooth_layer_2 {
            bindings = <&mo BLU>;
            key-positions = <41 36>;
        };

        bluetooth_layer_3 {
            bindings = <&mo BLU>;
            key-positions = <39 40 41>;
        };
    };

    macros {
        shift_lang: shift_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LALT)>;
        };

        lang_dollar: lang_dollar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp DOLLAR &shift_lang>;
        };

        lang_hash: lang_hash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp HASH &shift_lang>;
        };

        lang_at: lang_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp AT_SIGN &shift_lang>;
        };

        lang_excl: lang_excl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp EXCLAMATION &shift_lang>;
        };

        lang_amps: lang_amps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp AMPERSAND &shift_lang>;
        };

        lang_astr: lang_astr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp ASTERISK &shift_lang>;
        };

        lang_lpar: lang_lpar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp LEFT_PARENTHESIS &shift_lang>;
        };

        lang_rpas: lang_rpas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp RIGHT_PARENTHESIS &shift_lang>;
        };

        lang_prcnt: lang_prcnt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp PERCENT &shift_lang>;
        };

        lang_caret: lang_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp CARET &shift_lang>;
        };

        lang_comma: lang_comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp COMMA &shift_lang>;
        };

        lang_period: lang_period {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp PERIOD &shift_lang>;
        };

        lang_slash: lang_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp SLASH &shift_lang>;
        };

        lang_backslash: lang_backslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp BACKSLASH &shift_lang>;
        };

        lang_leftbracket: lang_leftbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp LEFT_BRACKET &shift_lang>;
        };

        lang_rightbracket: lang_rightbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp RIGHT_BRACKET &shift_lang>;
        };

        lang_grave: lang_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&shift_lang &kp GRAVE &shift_lang>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEF";
            bindings = <
&kp ESC    &kp BACKSLASH   &kp W           &kp E             &kp R        &kp T      &kp Y            &kp U        &kp I                &kp O            &none                    &none
&kp SLASH  &kp Q           &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &kp G      &kp H            &mt LCTRL J  &mt RIGHT_SHIFT K    &mt RIGHT_ALT L  &kp P                    &kp LEFT_BRACKET
&kp Z      &mt LEFT_GUI A  &kp X           &kp C             &kp V        &kp B      &kp N            &kp M        &kp COMMA            &kp DOT          &mt RIGHT_GUI SEMICOLON  &kp SQT
                                           &lt 4 DEL         &lt 2 TAB    &lt 1 RET  &lt 1 BACKSPACE  &lt 5 SPACE  &lt 4 LS(LALT)
            >;
        };

        lower_layer {
            display-name = "LWR";
            bindings = <
&kp F1           &kp F2      &kp F3    &kp F4     &kp F5     &kp F6   &kp F7  &kp F8    &kp F9  &kp F10   &kp F11       &kp F12
&kp SCROLLLOCK   &kp INSERT  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &trans  &kp LEFT  &kp UP  &kp DOWN  &kp NUMBER_0  &kp PRINTSCREEN
&kp PAUSE_BREAK  &kp N1      &kp N2    &kp N3     &kp N4     &kp N5   &kp N6  &kp N7    &kp N8  &kp N9    &kp RIGHT     &mt RCTRL DELETE
                                       &trans     &trans     &trans   &trans  &trans    &trans
            >;
        };

        raise_layer {
            display-name = "RSE";
            bindings = <
&none      &none        &kp CARET       &kp UNDERSCORE     &kp DOLLAR  &kp PERCENT    &kp ASTERISK     &kp EQUAL     &kp MINUS             &kp PLUS               &none             &none
&kp GRAVE  &kp AT_SIGN  &kp APOSTROPHE  &kp DOUBLE_QUOTES  &kp COMMA   &kp COLON      &kp SEMICOLON    &kp PERIOD    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE
&kp TILDE  &kp PIPE     &kp BACKSLASH   &kp SLASH          &kp HASH    &kp AMPERSAND  &kp EXCLAMATION  &kp QUESTION  &kp LESS_THAN         &kp GREATER_THAN       &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                        &trans             &trans      &trans         &trans           &trans        &trans
            >;
        };

        bluetooth_layer {
            display-name = "BLU";
            bindings = <
&bt BT_CLR   &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none        &none         &none         &none         &none         &out OUT_BLE  &out OUT_BLE  &none         &none         &none         &none         &none
&bootloader  &none         &none         &none         &none         &out OUT_USB  &out OUT_USB  &none         &none         &none         &none         &bootloader
                                         &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        hotcut_layer {
            display-name = "HOT";
            bindings = <
&kp LG(D)    &kp LS(LG(Z))  &kp LG(S)  &kp LS(LG(X))  &kp LC(PG_UP)           &kp LC(PG_DN)       &kp C_PREVIOUS  &kp LS(LG(S))   &kp LS(LG(PSCRN))  &kp LG(L)     &trans  &trans
&kp LA(TAB)  &kp LC(Z)      &kp LG(X)  &kp LG(C)      &kp LG(LS(LEFT_ARROW))  &kp LS(LG(RIGHT))   &kp C_PP        &kp C_VOL_DN    &kp K_MUTE         &kp C_VOL_UP  &trans  &trans
&trans       &kp LG(Z)      &kp LC(X)  &kp LC(C)      &kp LC(V)               &kp LC(LA(DELETE))  &kp C_NEXT      &kp K_PREVIOUS  &kp K_PLAY_PAUSE   &kp C_NEXT    &trans  &trans
                                       &trans         &trans                  &trans              &trans          &trans          &trans
            >;
        };

        chg_lang {
            display-name = "CHG";
            bindings = <
&none        &none     &kp CARET        &kp UNDERSCORE     &lang_dollar  &lang_prcnt  &lang_astr   &kp EQUAL     &kp MINUS    &kp PLUS      &none              &none
&lang_grave  &lang_at  &kp APOS         &kp DOUBLE_QUOTES  &lang_comma   &kp COLON    &lang_caret  &lang_period  &lang_lpar   &lang_rpas    &lang_leftbracket  &kp GRAVE
&kp TILDE    &kp PIPE  &lang_backslash  &lang_slash        &lang_hash    &lang_amps   &lang_excl   &kp QUESTION  &lang_comma  &lang_period  &lang_leftbracket  &lang_rightbracket
                                        &trans             &trans        &trans       &trans       &trans        &trans
            >;
        };
    };
};
